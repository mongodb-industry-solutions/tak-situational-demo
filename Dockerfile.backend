FROM python:3.13-slim

WORKDIR /

RUN pip install uv

# Copy lock file + manifest first so this layer is cached until deps change
COPY backend/pyproject.toml backend/uv.lock ./

# --frozen: skip resolution, install exactly what the lock file says
RUN uv sync --no-dev --frozen

COPY ./backend/ .

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
