# Pinned to a release patched for CVE-2026-111497 (Brotli OOB write); the floating 22-alpine tag can resolve to a stale cached layer.
FROM node:22.23.4-alpine
RUN apk upgrade --no-cache brotli-libs
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build
EXPOSE 8080
CMD ["npm", "start"]
