# MongoDB Atlas connection string
MONGODB_URI="<your-mongo-uri>"
# Name of the Atlas database containing Ditto connector collections
DATABASE_NAME="<your-database-name>"
# Ditto
DITTO_URL_EP="<your-ditto-url-endpoint>"
DITTO_API_KEY="<your-ditto-api-key>"
# AI SYSTEM
LLM_API_KEY="<your-mongodb-gateway-key>"
LLM_BASE_URL="<your-azure-apim-base-url>"
LLM_MODEL="claude-opus-4-7"
# GENYMOTION — Only for deployed version, not needed for local development
GENYMOTION_PAAS_HOST_ALPHA="<alpha-host>"
GENYMOTION_PAAS_TOKEN_ALPHA="<alpha-instance-id>"
GENYMOTION_PAAS_HOST_BRAVO="<bravo-host>"
GENYMOTION_PAAS_TOKEN_BRAVO="<bravo-instance-id>"