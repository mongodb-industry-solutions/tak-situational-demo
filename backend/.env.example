# Backend configuration.
#
#   cp backend/.env.example backend/.env
#
# You only need this file when running the backend DIRECTLY on your machine
# (uvicorn on :8000) against your own MongoDB and Ditto instances.
#
# If you are using the supported local path — `make setup`, which brings up
# MongoDB Enterprise Advanced and a self-hosted Ditto Big Peer in a kind
# cluster — you do NOT need this file at all. scripts/setup.sh generates every
# value below and injects them as Kubernetes Secrets. See docs/RUN_LOCAL.md.
#
# ==========================================================================
# REQUIRED
# ==========================================================================

# MongoDB connection string. Self-managed/EA and Atlas both work.
#   self-hosted : mongodb://dashboard:<pw>@localhost:27017/tak_demo?authSource=admin&directConnection=true
#   Atlas       : mongodb+srv://<user>:<pw>@<cluster>.mongodb.net/
MONGODB_URI="<your-mongo-uri>"

# Database holding the Ditto-synced collections (track, mapitem, chat, file, alert).
DATABASE_NAME="tak_demo"

# Optional: shows up as the client name in MongoDB logs and Atlas/OM metrics.
APP_NAME="tak-situational-demo-backend"

# ==========================================================================
# DITTO — pick ONE of the two blocks below
# ==========================================================================

# ── A) Self-hosted Big Peer (Ditto Operator) ──────────────────────────────
# Base URL of the Big Peer HTTP API, used to proxy ATAK photo attachments.
# Include the scheme AND the App ID path segment — the self-hosted HTTP API is
# app-scoped. A bare hostname is also accepted and treated as Ditto Cloud
# (https://<host>, no app path).
# DITTO_URL_EP="http://localhost:8080/7a9f1c4e-2b6d-4f83-9c15-8e0d3a5b7f42"
# API key minted through the Ditto Operator management API.
# DITTO_API_KEY="<big-peer-api-key>"
#
# These four let the backend generate the ATAK mesh-join QR in-process
# (GET /api/ditto/qr) and serve the same values as JSON (/api/ditto/identity).
# DITTO_APP_ID="7a9f1c4e-2b6d-4f83-9c15-8e0d3a5b7f42"
# DITTO_AUTH_URL="http://ditto.192.168.1.23.nip.io"
# DITTO_WS_URL="ws://ditto.192.168.1.23.nip.io"
# DITTO_PLAYGROUND_TOKEN="<shared-playground-token>"

# ── B) Ditto Cloud (the internal deployment) ──────────────────────────────
# Big Peer hostname, no scheme — assumed HTTPS, no app path segment.
# DITTO_URL_EP="<your-big-peer-host>"
# DITTO_API_KEY="<your-ditto-api-key>"
#
# Pre-made mesh-join QR in private S3 (it encodes a real credential, so it is
# never committed). Credentials resolve via IRSA or a local AWS profile.
# S3_ASSET_BUCKET="<s3-bucket>"
# S3_ASSET_KEY="<demo-name>/<asset>.png"
# S3_ASSET_REGION="us-east-1"

# ==========================================================================
# AI PANEL (LEAFY-AI) — optional, pick ONE
# ==========================================================================
# With neither configured the panel hides itself and the rest of the dashboard
# works normally.

# ── A) Ollama (local, no account needed) ──────────────────────────────────
# The model MUST support tool calling — the agent only answers from live
# MongoDB data via four tools.
# LLM_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://localhost:11434"
# LLM_MODEL="qwen2.5:7b"
# LLM_TIMEOUT_SECONDS="300"

# ── B) MongoDB internal LLM gateway (the Kanopy deployment) ───────────────
# LLM_PROVIDER="anthropic"
# LLM_API_KEY="<your-mongodb-gateway-key>"
# LLM_BASE_URL="<your-azure-apim-base-url>"
# LLM_MODEL="claude-opus-4-7"

# ==========================================================================
# FEATURE FLAGS
# ==========================================================================
# The Simulate view (Genymotion-backed ATAK emulation) is paused internal work.
# Left off, the nav button and /simulate route are hidden.
# ENABLE_SIMULATE="false"

# ==========================================================================
# GENYMOTION — deployed/internal only, not needed for local development
# ==========================================================================
# GENYMOTION_PAAS_HOST_ALPHA="<alpha-host>"
# GENYMOTION_PAAS_TOKEN_ALPHA="<alpha-instance-id>"
# GENYMOTION_PAAS_HOST_BRAVO="<bravo-host>"
# GENYMOTION_PAAS_TOKEN_BRAVO="<bravo-instance-id>"
